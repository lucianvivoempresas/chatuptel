# Copie para /etc/voltconnect-chat/operations.env e mantenha permissão 600.
# Para backup realmente externo, configure uma das opções abaixo.
BACKUP_REMOTE=
BACKUP_EXTERNAL_DIR=
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30

# Alertas remotos opcionais. Webhook deve aceitar JSON {"text":"..."}.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
