# Imagens fixadas. Atualize conscientemente e execute as migrações.
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.9.2-ce
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine

# Endereço público. Chatwoot deve operar na raiz de um domínio/subdomínio.
FRONTEND_URL=https://chat.voltconect.com.br

# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=troque-por-um-segredo-de-128-caracteres

# Gere senhas diferentes com: openssl rand -base64 36
POSTGRES_PASSWORD=troque-esta-senha
REDIS_PASSWORD=troque-esta-senha

# E-mail (preencher antes de convidar atendentes).
MAILER_SENDER_EMAIL=Volt Conect <atendimento@voltconect.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# WPPConnect. Use apenas letras, números, "_" e "-".
WPP_SESSION=voltconect
WPP_SECRET_KEY=troque-por-outro-segredo-longo
WPP_DEVICE_NAME=Volt Conect Atendimento

# Preencha após criar a conta e a caixa "API" no Chatwoot.
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=

# Localização e telemetria.
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_TELEMETRY=true

