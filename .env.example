# Imagens fixadas. Atualize conscientemente e execute as migrações.
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.17.0-ce
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine

# Endereço público. Chatwoot deve operar na raiz de um domínio/subdomínio.
FRONTEND_URL=https://chat.voltconect.com.br

# Necessário porque o webhook da caixa API aponta para o gateway Baileys na
# rede Docker privada. Mantenha a rede app sem exposição pública direta.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=troque-por-um-segredo-de-128-caracteres

# Gere senhas diferentes com: openssl rand -hex 32
POSTGRES_PASSWORD=troque-esta-senha
REDIS_PASSWORD=troque-esta-senha

# E-mail (preencher antes de convidar atendentes).
MAILER_SENDER_EMAIL="Volt Conect <atendimento@voltconect.com.br>"
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Gateway Baileys. Gere com: openssl rand -hex 32
BAILEYS_ADMIN_TOKEN=troque-por-outro-segredo-longo

# Preencha após criar a conta e a caixa "API" no Chatwoot.
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_API_TOKEN=troque-pelo-token-de-um-administrador-da-conta
# Preenchidos automaticamente por scripts/configure-bot-user.sh.
CHATWOOT_BOT_API_TOKEN=
CHATWOOT_BOT_USER_ID=0
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_PREFIX_AGENT_NAME=true
WHATSAPP_BOT_ENABLED=true
BAILEYS_AUDIT_RETENTION_DAYS=90
WHATSAPP_GLOBAL_PER_MINUTE=60
WHATSAPP_RECIPIENT_PER_MINUTE=10
WHATSAPP_AGENT_DAILY_LIMIT=500
# Ative temporariamente com 30 somente durante uma importação por novo QR Code.
WHATSAPP_HISTORY_SYNC_DAYS=0

# OperaÃ§Ã£o. BACKUP_REMOTE usa um destino rclone, preferencialmente do tipo crypt.
# Exemplo: BACKUP_REMOTE=cofre-criptografado:voltconect-chat
BACKUP_REMOTE=
BACKUP_EXTERNAL_DIR=
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30

# Alertas opcionais. Sem estes dados, as ocorrÃªncias continuam registradas no servidor.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Integração assíncrona de leads de Energia com o EnergiaVolt.
# Use o mesmo segredo em CHATWOOT_INTEGRATION_TOKEN no crm-server.
ENERGIA_CRM_URL=http://host.docker.internal:3000
ENERGIA_CRM_INTEGRATION_TOKEN=troque-por-um-segredo-gerado-com-openssl

# Leitura automática de faturas. Separe chaves de projetos diferentes por vírgula.
# Chaves do mesmo projeto compartilham a mesma cota do Gemini.
GEMINI_API_KEYS=
GEMINI_INVOICE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4.1-mini
OPENAI_INVOICE_MAX_OUTPUT_TOKENS=800
ENERGY_INVOICE_MAX_BYTES=15728640
SDR_AI_MAX_CALLS_PER_CONVERSATION=12
SDR_AI_MAX_TOKENS_PER_CONVERSATION=60000
SDR_AI_MAX_COST_USD_PER_CONVERSATION=0.05

# Assistente Uptel. Reutiliza OPENAI_API_KEY e mantém Zyloo somente como compatibilidade.
ASSISTANT_AI_PROVIDER=openai
ASSISTANT_AI_BASE_URL=https://api.openai.com/v1
ASSISTANT_AI_MODEL=gpt-5.6-luna
ASSISTANT_AI_MAX_OUTPUT_TOKENS=450
ASSISTANT_AI_REASONING_EFFORT=low
ASSISTANT_AI_INPUT_COST_PER_MILLION=0.20
ASSISTANT_AI_CACHED_INPUT_COST_PER_MILLION=0.02
ASSISTANT_AI_OUTPUT_COST_PER_MILLION=1.20
ASSISTANT_MAX_CONTEXT_MESSAGES=6
ASSISTANT_MAX_MESSAGE_CHARS=800
ASSISTANT_KNOWLEDGE_MAX_RESULTS=3
ASSISTANT_KNOWLEDGE_MAX_CHARS=3500
ASSISTANT_MAX_AI_CALLS_PER_CONVERSATION=20
ASSISTANT_MAX_AI_TOKENS_PER_CONVERSATION=80000
ASSISTANT_MAX_AI_COST_USD_PER_CONVERSATION=0.05
# Compatibilidade temporária. Nunca envie chaves ao GitHub.
ZYLOO_API_KEY=
ZYLOO_BASE_URL=https://api.zyloo.io/v1
ZYLOO_MODEL=zyloo/gpt-4.1
ZYLOO_MAX_TOKENS=700
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
KNOWLEDGE_BASE_DIR=/app/knowledge

# Localização e telemetria.
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_TELEMETRY=true
